generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  CAPTAIN
  TRIAL
  PLAYER
  SUB
  ANALYST
  COACH
}

enum TeamApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ScrimStatus {
  OPEN
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ScrimAvailabilityStatus {
  OPEN
  PENDING
  BOOKED
  CANCELLED
}

enum ScrimRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ScrimMatchStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ScheduleEventType {
  PRACTICE
  SCRIM
  TOURNAMENT
  REVIEW
  STREAM
}

enum BroadcastStatus {
  LIVE
  UPCOMING
  ENDED
}

model User {
  id               String           @id @default(cuid())
  steamId          String           @unique
  discordUsername  String?
  profileName      String
  avatarUrl        String?
  headline         String?
  region           String?
  deadlockRank     String?
  deadlockRankTier Int?
  deadlockRankSubrank Int?
  deadlockRankBadgeLevel Int?
  deadlockRankFetchedAt DateTime?
  isLFT            Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberships      TeamMembership[]
  ownedTeams       Team[]           @relation("TeamOwner")
  applications     TeamApplication[]
  createdScrims    ScrimRequest[]   @relation("ScrimCreator")
  createdAvailabilityBlocks ScrimAvailabilityBlock[] @relation("ScrimAvailabilityCreator")
  createdScrimBookingRequests ScrimBookingRequest[] @relation("ScrimBookingRequester")
  sentScrimMessages ScrimMessage[]   @relation("ScrimMessageSender")
  notifications     Notification[]
}

model Team {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  tag               String            @unique
  region            String
  focus             String
  primaryRank       String
  primaryRankBadgeLevel Int?
  primaryRankUpdatedAt DateTime?
  description       String
  recruiting        Boolean           @default(true)
  openRoles         String[]
  ownerId           String
  inviteToken       String?           @unique
  inviteExpiresAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  owner             User              @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships       TeamMembership[]
  applications      TeamApplication[]
  requestedScrims   ScrimRequest[]    @relation("RequesterTeam")
  opponentScrims    ScrimRequest[]    @relation("OpponentTeam")
  availabilityBlocks ScrimAvailabilityBlock[]
  outgoingScrimRequests ScrimBookingRequest[] @relation("RequestingScrimTeam")
  incomingScrimRequests ScrimBookingRequest[] @relation("ReceivingScrimTeam")
  teamAScrims       Scrim[]           @relation("ScrimTeamA")
  teamBScrims       Scrim[]           @relation("ScrimTeamB")
  sentScrimMessages ScrimMessage[]    @relation("ScrimMessageTeam")
  scheduleEvents    ScheduleEvent[]
  tournamentEntries TournamentEntry[]
}

model TeamMembership {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      MembershipRole
  joinedAt  DateTime       @default(now())
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamApplication {
  id         String                 @id @default(cuid())
  teamId     String
  userId     String
  message    String?
  status     TeamApplicationStatus  @default(PENDING)
  createdAt  DateTime               @default(now())
  declinedAt DateTime?
  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model ScrimRequest {
  id              String       @id @default(cuid())
  requesterTeamId String
  opponentTeamId  String?
  createdById     String
  status          ScrimStatus  @default(OPEN)
  format          String
  region          String
  wantedRank      String
  notes           String?
  startsAt        DateTime
  createdAt       DateTime     @default(now())
  requesterTeam   Team         @relation("RequesterTeam", fields: [requesterTeamId], references: [id], onDelete: Cascade)
  opponentTeam    Team?        @relation("OpponentTeam", fields: [opponentTeamId], references: [id], onDelete: SetNull)
  createdBy       User         @relation("ScrimCreator", fields: [createdById], references: [id], onDelete: Cascade)
  scheduleEvents  ScheduleEvent[]

  @@index([requesterTeamId, startsAt])
}

model ScrimAvailabilityBlock {
  id              String                  @id @default(cuid())
  teamId          String
  startTime       DateTime
  endTime         DateTime
  region          String
  notes           String?
  status          ScrimAvailabilityStatus @default(OPEN)
  createdByUserId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  team            Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("ScrimAvailabilityCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  requests        ScrimBookingRequest[]
  scrim           Scrim?

  @@index([teamId, startTime])
  @@index([status, startTime])
}

model ScrimBookingRequest {
  id                  String             @id @default(cuid())
  availabilityBlockId String
  requestingTeamId    String
  receivingTeamId     String
  requestedByUserId   String
  message             String?
  status              ScrimRequestStatus @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  availabilityBlock   ScrimAvailabilityBlock @relation(fields: [availabilityBlockId], references: [id], onDelete: Cascade)
  requestingTeam      Team               @relation("RequestingScrimTeam", fields: [requestingTeamId], references: [id], onDelete: Cascade)
  receivingTeam       Team               @relation("ReceivingScrimTeam", fields: [receivingTeamId], references: [id], onDelete: Cascade)
  requestedBy         User               @relation("ScrimBookingRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  conversation         ScrimConversation?

  @@unique([availabilityBlockId, requestingTeamId])
  @@index([receivingTeamId, status, createdAt])
  @@index([requestingTeamId, status, createdAt])
}

model Scrim {
  id                  String            @id @default(cuid())
  teamAId             String
  teamBId             String
  availabilityBlockId String            @unique
  startTime           DateTime
  endTime             DateTime
  status              ScrimMatchStatus  @default(CONFIRMED)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  teamA               Team              @relation("ScrimTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB               Team              @relation("ScrimTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  availabilityBlock   ScrimAvailabilityBlock @relation(fields: [availabilityBlockId], references: [id], onDelete: Cascade)
  conversation        ScrimConversation?

  @@index([teamAId, startTime])
  @@index([teamBId, startTime])
  @@index([status, startTime])
}

model ScrimConversation {
  id               String               @id @default(cuid())
  bookingRequestId String?              @unique
  scrimId          String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  bookingRequest   ScrimBookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  scrim            Scrim?               @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  messages         ScrimMessage[]

  @@index([createdAt])
}

model ScrimMessage {
  id             String             @id @default(cuid())
  conversationId String
  senderUserId   String
  senderTeamId   String
  body           String
  createdAt      DateTime           @default(now())
  conversation   ScrimConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User               @relation("ScrimMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  senderTeam     Team               @relation("ScrimMessageTeam", fields: [senderTeamId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  type            String
  title           String
  body            String
  relatedEntityId String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ScheduleEvent {
  id         String            @id @default(cuid())
  teamId     String
  scrimId    String?
  title      String
  type       ScheduleEventType
  startsAt   DateTime
  endsAt     DateTime
  location   String?
  notes      String?
  createdAt  DateTime          @default(now())
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scrim      ScrimRequest?     @relation(fields: [scrimId], references: [id], onDelete: SetNull)

  @@index([teamId, startsAt])
}

model Tournament {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  organizer         String
  region            String
  platform          String
  format            String
  prizePool         String?
  entryRequirements String?
  registrationUrl   String
  startsAt          DateTime
  featured          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  entries           TournamentEntry[]
  broadcasts        Broadcast[]
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  teamId       String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

model Broadcast {
  id           String          @id @default(cuid())
  tournamentId String?
  title        String
  channel      String
  status       BroadcastStatus
  startsAt     DateTime
  createdAt    DateTime        @default(now())
  tournament   Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
}
